{
  "name": "@swap3d/cli",
  "version": "0.3.0",
  "description": "Convert 3D files from your terminal with the Swap3D API.",
  "type": "module",
  "bin": {
    "swap3d": "./src/cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/swap3d/swap3d-cli.git"
  },
  "bugs": {
    "url": "https://github.com/swap3d/swap3d-cli/issues"
  },
  "homepage": "https://swap3d.studio",
  "files": [
    "src",
    "assets",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build:standalone": "bun scripts/build-standalone.mjs",
    "build:standalone:all": "bun scripts/build-standalone.mjs --all",
    "generate:homebrew": "node scripts/generate-homebrew-formula.mjs",
    "package:standalone": "node scripts/package-standalone.mjs",
    "test": "node --test",
    "smoke:local": "node src/cli.mjs formats"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "swap3d",
    "3d",
    "conversion",
    "gltf",
    "glb",
    "cli"
  ],
  "dependencies": {
    "@swap3d/sdk": "^0.1.0"
  },
  "license": "Apache-2.0"
}
